<h2>{{ page_title|default('Генератор новостей'|trans) }}</h2>
<p class="fg-gray">{{ 'Добавьте выбор шаблона, количество публикаций и запуск генерации новостей через DevCraft AJAX.'|trans }}</p>

<form class="js-dle-faker-news-form">
    <div class="grid">
        <div class="row">
            <div class="cell-md-8">
                <label>{{ 'Шаблон'|trans }}</label>
                <select name="template" data-role="select">
                    <option value="">{{ 'Выберите шаблон'|trans }}</option>
                    {% for item in templates %}
                        <option value="{{ item.id }}">{{ item.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="cell-md-4">
                <label>{{ 'Количество'|trans }}</label>
                <input type="number" name="count" min="1" value="1">
            </div>
        </div>
        <div class="row mt-4">
            <div class="cell-12">
                <button type="submit" class="button primary">{{ 'Сгенерировать новости'|trans }}</button>
            </div>
        </div>
    </div>
</form>

<div class="mt-4 js-dle-faker-news-results"></div>
