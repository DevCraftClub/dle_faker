<h2>{{ page_title|default('Файлы'|trans) }}</h2>
<p class="fg-gray">{{ 'Загружайте файлы для медиа-полей генерации новостей и пользователей.'|trans }}</p>

{% set kind = kind|default('file') %}

{% include 'core/includes/upload/drop_form.twig' with {
    form_class: 'js-dle-faker-static-upload mb-3',
    form_attrs: { 'data-kind': kind },
    accept: accept|default(''),
    multiple: true,
    drop_title: drop_title|default('Перетащите файлы сюда'|trans),
    upload_label: upload_label|default('Загрузить файл'|trans),
    progress_class: 'js-dle-faker-static-progress',
    progress_label_class: 'js-dle-faker-static-progress-label',
    hint: ('Разрешено:'|trans) ~ ' ' ~ (allowed_ext|default([])|join(', '))
} %}

<ul class="js-dle-faker-static-list" data-kind="{{ kind }}" data-empty="{{ empty_label|default('Пока нет файлов'|trans)|e('html_attr') }}">
    {% for item in items|default([]) %}
        <li data-id="{{ item.id }}">
            {{ item.original_name }}
            <button type="button" class="button small alert js-dle-faker-static-delete" data-id="{{ item.id }}">{{ 'Удалить'|trans }}</button>
        </li>
    {% else %}
        <li class="fg-gray js-dle-faker-static-empty">{{ empty_label|default('Пока нет файлов'|trans) }}</li>
    {% endfor %}
</ul>
